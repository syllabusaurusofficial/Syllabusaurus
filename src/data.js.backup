export const syllabus={Physics:{"Units & Measurements":[{id:"dimensions",name:"Dimensions",difficulty:"Medium",explanation:"Dimensions describe a physical quantity using fundamental quantities.",keyPoints:["Used to check equations.","Expressed using M, L and T."],formula:"Velocity = [LT⁻¹]",mistakes:["Forgetting powers of fundamental quantities."],questions:[{question:"What is the dimensional formula of velocity?",options:["[LT⁻¹]","[LT⁻²]","[MLT⁻¹]","[M⁰L⁰T⁰]"],answer:"[LT⁻¹]"}]}]}};