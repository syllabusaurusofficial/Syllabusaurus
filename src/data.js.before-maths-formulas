const makeConcepts = (names) =>
  names.map((name, index) => ({
    id: String(index + 1),
    name,
    difficulty: "Medium",
    explanation: name === "Dimensions" ? "The dimensions of a physical quantity show how it depends on fundamental quantities such as mass (M), length (L) and time (T). A dimensional formula represents this dependence using powers of fundamental quantities." : name === "Units" ? "A unit is a fixed standard quantity used to measure a physical quantity. In the SI system, fundamental quantities have standard base units such as metre (m), kilogram (kg) and second (s)." : name === "Errors" ? "Every measurement has some uncertainty. Errors describe the difference between a measured value and the true or accepted value. Absolute, relative and percentage errors are commonly used." : name === "Significant Figures" ? "Significant figures are the meaningful digits in a measured quantity. They include all certain digits plus the first uncertain digit." : name === "Dimensional Analysis" ? "Dimensional analysis uses the dimensions of physical quantities to test equations and establish relationships between quantities. It cannot determine dimensionless numerical constants." : name === "Distance Formula" ? "d = √[(x₂ − x₁)² + (y₂ − y₁)² + (z₂ − z₁)²]" : name === "Direction Ratios" ? "DRs = (x₂ − x₁) : (y₂ − y₁) : (z₂ − z₁)" 
: name === "Direction Cosines"
? "l = a/√(a²+b²+c²), m = b/√(a²+b²+c²), n = c/√(a²+b²+c²)"
: name === "Coordinates in 3D"
? "P = (x, y, z)"
: name === "Position and Displacement" ? "Displacement has both magnitude and direction. Unlike distance, it depends only on the initial and final positions, not on the complete path followed." : `${name} is a core concept in this chapter. Start with its definition, understand the underlying idea, learn the relevant relationships or formulas, and practise applying the concept to numerical and conceptual questions.`,
    keyPoints: [
      name === "Dimensions" ? "Dimensions describe a physical quantity using powers of fundamental quantities." : `Understand the basic idea of ${name}.`,
      `Learn the important definitions and relationships.`,
      `Practise questions based on ${name}.`
    ],
    formula: name === "Dimensions" ? "For a physical quantity Q: [Q] = MᵃLᵇTᶜ. Examples: velocity = [LT⁻¹], acceleration = [LT⁻²], force = [MLT⁻²], work = [ML²T⁻²]." : name === "Units" ? "Physical quantity = numerical value × unit." : name === "Errors" ? "Percentage error = (absolute error / measured value) × 100." : name === "Significant Figures" ? "For multiplication or division, keep the same number of significant figures as the least precise measurement." : name === "Dimensional Analysis" ? "A dimensional equation compares the dimensions of physical quantities. It is used to check the consistency of equations, derive relations and convert units." : name === "Distance Formula" ? "d = √[(x₂ − x₁)² + (y₂ − y₁)² + (z₂ − z₁)²]" : name === "Direction Ratios" ? "DRs = (x₂ − x₁) : (y₂ − y₁) : (z₂ − z₁)" 
: name === "Direction Cosines"
? "l = a/√(a²+b²+c²), m = b/√(a²+b²+c²), n = c/√(a²+b²+c²)"
: name === "Coordinates in 3D"
? "P = (x, y, z)"
: name === "Position and Displacement" ? "Position specifies where an object is located relative to a chosen origin. Displacement is the change in position from the initial position to the final position and is a vector quantity." : "Identify the standard NCERT definitions, relationships and formulae associated with this concept.",
    mistakes: [
      "Do not confuse definitions or units.",
      "Check the given information before applying a formula."
    ],
    questions: [
      {
        question: `Which statement best describes ${name}?`,
        options: [
          "It is a concept used to understand the topic.",
          "It is unrelated to the chapter.",
          "It is only a numerical value.",
          "It has no application."
        ],
        answer: "It is a concept used to understand the topic."
      }
    ]
  }));

